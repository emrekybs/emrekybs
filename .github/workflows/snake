name: snake

on:
  schedule:
    - cron: "0 */12 * * *"
  workflow_dispatch:
  push:
    branches: [main]

permissions:
  contents: write

jobs:
  generate:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - name: Katkı grafiğinden snake üret
        uses: Platane/snk@v3
        with:
          github_user_name: ${{ github.repository_owner }}
          outputs: |
            dist/snake-dark.svg?palette=github-dark&color_snake=#F70000&color_dots=#161B22,#4C0000,#8B0000,#C00000,#F70000
            dist/snake-light.svg?palette=github-light&color_snake=#F70000&color_dots=#EBEDF0,#FFC1C1,#FF7B7B,#E02020,#9B0000

      - name: output dalına gönder
        uses: crazy-max/ghaction-github-pages@v4
        with:
          target_branch: output
          build_dir: dist
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
